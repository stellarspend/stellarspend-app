# StellarSpend — Environment Configuration
#
# Copy to `.env.local` and fill in values.
# See lib/api/horizon.ts for how these are consumed.

# Network selector: "testnet" (default) or "mainnet"
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Optional: explicit Horizon server URL.
# Overrides the built-in default for the chosen network.
# NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Optional: Soroban RPC URL for on-chain contract calls (budgets, analytics).
# NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Optional: Stellar network passphrase.
# NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
